{
  "type": "object",
  "required": [
    "adamId",
    "adChannelType",
    "billingEvent",
    "countriesOrRegions",
    "name",
    "supplySources"
  ],
  "properties": {
    "adamId": {
      "type": "integer"
    },
    "adChannelType": {
      "enum": ["DISPLAY", "SEARCH"]
    },
    "billingEvent": {
      "enum": ["IMPRESSIONS", "TAPS"]
    },
    "budgetAmount_currency": {
      "type": ["string", "null"]
    },
    "budgetAmount_amount": {
      "type": ["string", "null"]
    },
    "budgetOrders": {
      "type": "string"
    },
    "countriesOrRegions": {
      "type": "string"
    },
    "countryOrRegionServingStateReasons": {
      "type": "string"
    },
    "dailyBudgetAmount_currency": {
      "type": ["string", "null"]
    },
    "dailyBudgetAmount_amount": {
      "type": ["string", "null"]
    },
    "deleted": {
      "type": "boolean",
      "default": false
    },
    "displayStatus": {
      "enum": ["DELETED", "ON_HOLD", "PAUSED", "RUNNING"]
    },
    "endTime": {
      "type": ["null", "string"],
      "format": "date-time"
    },
    "id": {
      "type": "integer"
    },
    "locInvoiceDetails": {
      "type": ["null", "string"]
    },
    "modificationTime": {
      "type": "string",
      "format": "date-time"
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "orgId": {
      "type": "integer"
    },
    "paymentModel": {
      "enum": ["LOC", "PAYG", ""]
    },
    "servingStateReasons": {
      "type": ["null", "string"]
    },
    "servingStatus": {
      "enum": ["NOT_RUNNING", "RUNNING"]
    },
    "startTime": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["ENABLED", "PAUSED"],
      "default": "ENABLED"
    },
    "supplySources": {
      "type": "string"
    }
  }
}
